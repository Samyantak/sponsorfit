# --- Anthropic (kept available for later phases; not the default) ---
ANTHROPIC_API_KEY=

# --- OpenAI (kept available for later phases; not the default) ---
OPENAI_API_KEY=

# --- Ollama (local, default — $0 API cost) ---
# Requires the Ollama service running locally (default port 11434) with
# qwen3:8b and qwen3:14b pulled: `ollama pull qwen3:8b` / `qwen3:14b`.
# OLLAMA_BASE_URL=http://localhost:11434

# --- sponsorfit defaults ---
# Which provider/model the call_llm() convenience wrapper uses when not
# explicitly overridden. Ollama keeps ad-hoc/manual calls at $0.
SPONSORFIT_DEFAULT_PROVIDER=ollama
SPONSORFIT_DEFAULT_MODEL=qwen3:8b

# Per-phase model routing (each phase's own code passes `model=` explicitly
# to call_llm()/MeteredLLMClient.call() — these env vars are just the plan,
# not read by any code yet):
#   Embeddings and retrieval (Ph 2-3)  -> Ollama, local embedding model (shared cache)
#   Sponsor extraction (Phase 1)        -> Ollama qwen3:8b
#   Smoke tests, pipeline debugging     -> Ollama qwen3:8b
#   Prompt iteration (Phase 4)          -> Ollama qwen3:14b, batched overnight
#   Full test runs, headline numbers    -> Ollama qwen3:14b
#   Placement rerank (Phase 3)          -> Ollama qwen3:14b; one capped (<=$10)
#                                          Claude Sonnet comparison run
#   Strategy agent (Phase 5)            -> Ollama
# Anthropic/OpenAI remain available as an explicit provider= override for
# any call where a stronger cloud model is worth the (small) spend.

# Optional overrides — leave commented to use repo-relative defaults
# SPONSORFIT_COSTS_DB_PATH=data/costs.db
# SPONSORFIT_TRACES_DIR=traces
